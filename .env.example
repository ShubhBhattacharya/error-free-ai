GROQ_API_KEY=gsk_your_groq_api_key_here

# 2. Google AI Studio API (High-speed Multimodal & Synthesis)
# Powers: Google Gemini 1.5 Flash (Agent #5 Fact-Checker + The 11th Supreme Synthesizer Judge)
# Get free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=AIzaSy_your_google_ai_studio_key_here

# 3. OpenRouter API (Access to diverse free-tier model endpoints)
# Powers: Qwen 2.5 Coder, Microsoft Phi-3.5, Cohere Command R
# Get key at: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

