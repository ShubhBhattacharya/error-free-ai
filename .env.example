# ==========================================
# Error-Free AI Multi-Agent Consensus Engine
# Configuration & Provider API Keys
# ==========================================

# Groq LPU (Ultra-fast inference: llama-3.3-70b-versatile, etc.)
GROQ_API_KEY=gsk_your_groq_api_key_here

# OpenRouter (Aggregated access to Llama 3.3, Mistral, Qwen, DeepSeek, Claude, etc.)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here

# OpenAI (GPT-4o, GPT-4o-mini, o1, etc.)
OPENAI_API_KEY=sk-your_openai_api_key_here

# Google Gemini (Gemini 2.0 Flash, Gemini 1.5 Pro)
GEMINI_API_KEY=AIzaSy_your_gemini_api_key_here

# Anthropic Claude (Claude 3.5 Sonnet, Claude 3.5 Haiku)
ANTHROPIC_API_KEY=sk-ant-api03-your_anthropic_api_key_here

# Ollama Local Server (Local offline execution - e.g. http://localhost:11434)
OLLAMA_BASE_URL=http://localhost:11434

# Hugging Face Inference API
HUGGINGFACE_API_KEY=hf_your_huggingface_api_key_here
